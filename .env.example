APP_NAME=Mizan
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily, not single: one ever-growing laravel.log is how a week of errors hides in
# scrollback. The daily channel rotates per date and prunes after LOG_DAILY_DAYS (14).
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Error tracking. Unset means off, which is right everywhere but production.
# Leave it COMMENTED rather than empty: `SENTRY_LARAVEL_DSN=` is the string "",
# not absent, and an empty DSN fails Sentry's init instead of disabling it.
# Everything sent is scrubbed first — see App\Support\SentryScrubber.
# SENTRY_LARAVEL_DSN=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Sessions in Redis, on a database of their own (config/database.php).
# The file driver writes and locks a file per request; the database driver puts
# every page load behind a write to the same MySQL everything else queries.
SESSION_DRIVER=redis
SESSION_CONNECTION=sessions
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# The permission list, the module map and the sidebar badge counts are all read
# while the shell is assembled, so the cache is on the hot path of every page.
# On the database store that is a MySQL round trip each; Redis is already here
# for the queue.
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2

# Local: log. Production: failover — SendGrid first, Mailgun when SendGrid fails (config/mail.php).
MAIL_MAILER=log
SENDGRID_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Project alerts to Slack (docs/projects-listing-plan.md §11). Leave the token
# unset and the 'slack' channel is silently dropped from every alert's via().
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# Who hears that a backup failed. Falls back to MAIL_FROM_ADDRESS, and if neither
# is set `backup.notifications.mail.to` is null — which spatie/laravel-backup
# reports as `invalidEmail(): Argument #1 ($email) must be of type string, null
# given`, a TypeError naming nothing about the real cause. Undocumented here is
# how a production server came to have neither.
#
# Commented out, not empty, deliberately: `BACKUP_NOTIFICATION_EMAIL=` is the
# empty string, not absent, so it DEFEATS the MAIL_FROM_ADDRESS fallback and
# fails `composer install` on a fresh clone with `"" is not a valid email`.
# Uncomment it only to set a real address.
# BACKUP_NOTIFICATION_EMAIL=

# Encrypts the backup archive. **Unset means the archive is not encrypted** — the
# package's own config says "Set to `null` to disable encryption", and an absent
# variable is that null. A database dump sitting unencrypted on remote storage is
# worth deciding about rather than inheriting.
BACKUP_ARCHIVE_PASSWORD=

# Where backups are written. Default `local` keeps them on the same disk as the
# database — which survives a bad deploy but not a dead disk. Add an off-box copy
# with `local,s3` and fill the S3-compatible credentials below; set continue-on-
# failure so a blip reaching the remote never discards the local archive.
# BACKUP_DISKS=local,s3
# BACKUP_CONTINUE_ON_FAILURE=true

# The `s3` disk is S3-COMPATIBLE, not AWS-only: point AWS_ENDPOINT at Backblaze B2,
# Wasabi, DigitalOcean Spaces or MinIO and set path-style if the provider needs it.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# AWS_ENDPOINT=https://s3.us-west-000.backblazeb2.com
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SIGNATURE_PATH="storage/signatures/employer_signature1.png"
NODE_BINARY=
NPM_BINARY=

# Which engine renders PDFs: browsershot (headless Chrome, real CSS — needs Node
# *and* Puppeteer's Chrome), dompdf (pure PHP, no flexbox or grid), or auto, which
# probes for Node and falls back. Templates carry per-engine CSS overrides either
# way. Set it explicitly on a server: `auto` shells out to probe on the first PDF,
# and "which engine is this box on" should be a decision somebody made rather than
# something discovered when a document looks wrong.
PDF_DRIVER=auto

CUSTOM_FIELDS_ENABLED=true

# Tenant (per-company) database connection. Defaults to a SQLite file per
# company under database/tenants/. Laravel's SQLite schema builder needs
# SQLite >= 3.16 built with virtual tables (pragma_table_xinfo); on shared
# hosting that is often not the case, so use MySQL in production:
# TENANT_DB_DRIVER=mysql
# TENANT_DB_HOST=127.0.0.1
# TENANT_DB_PORT=3306
# TENANT_DB_USERNAME=root
# TENANT_DB_PASSWORD=

# Seeding. The seeders create dummy data by default; point these at the real
# company and super admin on an installation that already has them, so `db:seed`
# matches the existing records instead of creating a second, dummy set.
SEED_COMPANY_NAME=
SEED_COMPANY_SLUG=
SEED_ADMIN_EMAIL=
# Required on a production host: seeding refuses the demo password there.
SEED_ADMIN_PASSWORD=
ACCOUNTING_AUTO_POST_PAYROLL=false

# Segregation of duties: on, whoever writes a journal entry cannot be the one
# who approves it. This is the installation default — a company can still
# choose for itself in Settings → Company Settings → Approvals, and its choice
# wins over this value.
#
# Set it to false on an installation where one person runs the books alone.
# There is nobody to route an entry to, so the rule stops being a control and
# becomes a dead end: the entry waits at pending approval forever while the
# money it describes has already left the bank. Self-approvals are still
# recorded as self-approvals in the audit trail.
ACCOUNTING_REQUIRE_SECOND_APPROVER=true

# ─── AI command bot ─── docs/ai-command-bot-plan.md
# Off unless a key is present AND AI_COMMANDS_ENABLED is true. Never commit a real key here.
AI_DRIVER=local
AI_COMMANDS_ENABLED=false
# AI_MODEL=claude-opus-5
# AI_EFFORT=low
# AI_CONFIRM_THRESHOLD=100000
# AI_VOICE_ENABLED=true

# WhatsApp delivery (payslips, campaigns). SendGrid is Twilio's email service and has no WhatsApp
# API; WhatsApp goes through Twilio itself. Drivers: log (default), twilio, cloud (Meta Cloud API).
WHATSAPP_DRIVER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=

# Scout. The `database` engine searches with SQL against the tables already here, so it
# needs no external service; the package default (`collection`) reads every row into PHP
# to filter it. Nothing uses the `Searchable` trait yet, so this decides nothing until
# something does — `SCOUT_QUEUE=true` is worth setting at the same time, since Horizon
# is already here to absorb the indexing.
SCOUT_DRIVER=database

# Octane serves the application: nginx proxies to it on 127.0.0.1:8000 and PHP-FPM is
# no longer in the request path (kept installed, so switching back is one vhost edit).
#
# RoadRunner rather than FrankenPHP on purpose: RoadRunner runs its workers with the
# system `/usr/bin/php`, so every extension this app needs (intl, gd, pecl-zip,
# pdo_mysql) is the same build already proven here. FrankenPHP embeds its own PHP,
# which is where an extension mismatch would surface — at runtime, on one screen.
#
# The framework now stays in memory between requests, so a deploy MUST end with
# `php artisan octane:reload` or the old code keeps serving. See config/octane.php's
# `flush` list for the singletons that would otherwise go stale.
OCTANE_SERVER=roadrunner

# API tokens expire this many minutes after they are issued (0 = never). Clients refresh at POST /api/refresh.
SANCTUM_TOKEN_EXPIRATION=43200
