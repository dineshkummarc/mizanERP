{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "erbiumtech/mizan",
    "type": "project",
    "description": "Mizan — multi-tenant HR, payroll and double-entry accounting for Pakistani businesses (Laravel + Filament).",
    "keywords": ["laravel", "filament", "payroll", "accounting", "hrms", "multi-tenant", "pakistan"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "anthropic-ai/sdk": "^0.51.0",
        "dompdf/dompdf": "^3.1",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.48",
        "laravel/octane": "^2.19",
        "laravel/reverb": "^1.11",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^11.7",
        "laravel/slack-notification-channel": "^3.10",
        "laravel/tinker": "^3.0",
        "predis/predis": "^3.5",
        "sentry/sentry-laravel": "^4.28",
        "spatie/browsershot": "^5.3",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-health": "^1.40",
        "spatie/laravel-multitenancy": "^4.1",
        "spatie/laravel-pdf": "^2.8",
        "spatie/laravel-permission": "^6.25",
        "spiral/roadrunner-cli": "^2.7",
        "spiral/roadrunner-http": "^4.1",
        "symfony/http-client": "^7.4",
        "symfony/mailgun-mailer": "^7.4",
        "symfony/sendgrid-mailer": "^7.4"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "brianium/paratest": "^7.8",
        "fakerphp/faker": "^1.23",
        "laravel/envoy": "^2.12",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3",
        "spatie/laravel-horizon-watcher": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "refresh": [
            "@php artisan migrate --force",
            "@php artisan tenants:migrate",
            "@php artisan db:seed --class=Database\\\\Seeders\\\\PermissionSeeder --force",
            "@php artisan db:seed --class=Database\\\\Seeders\\\\RoleSeeder --force"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "13.x-dev"
        },
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
